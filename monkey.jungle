project.manifest = manifest.xml

# Per-product launcher icon size.
#
# This is the whole of the device-variant mapping, and it is much
# shorter than ZabkaFinder's because the in-app logo is no longer a
# bitmap: AedLogo.mc draws it with primitives, so it scales to every
# screen for free and needs no variant at all. Only the launcher icon
# still has to be a real image, since Garmin renders that one itself.
#
# The variants/ folders live OUTSIDE resources/ on purpose - the
# resource compiler scans every resourcePath entry recursively and
# compiles all of it for every device, so opt-in variants must be
# mapped explicitly here. Each variant path is appended AFTER the base
# path, so its LauncherIcon overrides the fallback in resources/.
#
# Sizes come from Garmin's per-product specs and do not follow screen
# size: a 390 px Venu wants 60 px, a 390 px Forerunner 165 wants 54.
# Regenerate the PNGs with tools/make_icons.py after any change.

# --- 35 px --------------------------------------------------------
fr55.resourcePath = $(fr55.resourcePath);variants/icon-35

# --- 36 px --------------------------------------------------------
fenix5s.resourcePath = $(fenix5s.resourcePath);variants/icon-36

# --- 40 px --------------------------------------------------------
enduro.resourcePath = $(enduro.resourcePath);variants/icon-40
enduro3.resourcePath = $(enduro3.resourcePath);variants/icon-40
fenix5.resourcePath = $(fenix5.resourcePath);variants/icon-40
