<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
        type="watch-app", not "widget". Two reasons, and the first one
        decides it: a widget on a Forerunner 55 gets 64 KB for code,
        resources AND data together, which a dense city tile exceeds on
        its own before anything is parsed. An app gets 128 KB there, and
        proportionally more everywhere else.

        The second is that widgets are a dead end. On System 5 devices
        (Venu 2, Fenix 7 and later) they were superseded by glances, so
        a watch-app is also where users now expect to find this.
    -->
    <iq:application id="18ce5c46bcae4f1291dbfac7f3358e80" type="watch-app" name="@Strings.AppName" entry="AedFinderApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.1.0">
        <iq:products>
            <!-- Fenix 5 series (the CIQ 3.1 floor of the app) -->
            <iq:product id="fenix5"/>
            <iq:product id="fenix5s"/>
            <iq:product id="fenix5x"/>
            <iq:product id="fenix5plus"/>
            <iq:product id="fenix5splus"/>
            <iq:product id="fenix5xplus"/>
            <!-- Fenix 6 series -->
            <iq:product id="fenix6"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6s"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6xpro"/>
            <!-- Fenix 7 series -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
            <!-- Fenix 8 series + Fenix E -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenixe"/>
            <!-- Enduro -->
            <iq:product id="enduro"/>
            <iq:product id="enduro3"/>
            <!-- Epix (Gen 2) + Epix 2 Pro -->
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <!-- Forerunner -->
            <iq:product id="fr55"/>
            <iq:product id="fr70"/>
            <iq:product id="fr165"/>
            <iq:product id="fr165m"/>
            <iq:product id="fr170"/>
            <iq:product id="fr170m"/>
            <iq:product id="fr245"/>
            <iq:product id="fr245m"/>
            <iq:product id="fr255"/>
            <iq:product id="fr255m"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr255sm"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr57042mm"/>
            <iq:product id="fr57047mm"/>
            <iq:product id="fr645"/>
            <iq:product id="fr645m"/>
            <iq:product id="fr745"/>
            <iq:product id="fr935"/>
            <iq:product id="fr945"/>
            <iq:product id="fr945lte"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>
            <!-- Venu (round models only) -->
            <iq:product id="venu"/>
            <iq:product id="venud"/>
            <iq:product id="venu2"/>
            <iq:product id="venu2plus"/>
            <iq:product id="venu2s"/>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="venu441mm"/>
            <iq:product id="venu445mm"/>
        </iq:products>
        <iq:permissions>
            <!-- Communications: fetching the tile from GitHub Pages.
                 Positioning: reading GPS.
                 Sensor: reading the magnetic compass (optional at
                 runtime - watches without one fall back to the GPS
                 course).
                 Attention.vibrate needs no permission. -->
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>pol</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
